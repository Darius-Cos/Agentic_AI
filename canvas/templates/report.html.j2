<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title }}</title>
    <style>
        body { font-family: Georgia, serif; max-width: 900px; margin: 40px auto; padding: 0 20px; color: #333; line-height: 1.7; }
        h1 { color: #1a1a2e; border-bottom: 3px solid #4a90d9; padding-bottom: 10px; }
        h2 { color: #16213e; margin-top: 40px; }
        .meta { color: #666; font-size: 0.9em; margin-bottom: 30px; }
        .summary-box { background: #f0f4ff; border-left: 4px solid #4a90d9; padding: 16px 20px; border-radius: 4px; margin: 20px 0; }
        .section { margin: 30px 0; }
        .sources { font-size: 0.85em; color: #555; border-top: 1px solid #ddd; padding-top: 8px; margin-top: 12px; }
        .conclusions { background: #f9f9f9; padding: 16px 20px; border-radius: 4px; }
        .recommendations li { margin: 6px 0; }
        footer { margin-top: 60px; font-size: 0.8em; color: #aaa; text-align: center; }
    </style>
</head>
<body>
    <h1>{{ title }}</h1>
    <div class="meta">
        Generated: {{ generated_at }}
        {% if author %} &bull; Author: {{ author }}{% endif %}
    </div>

    <h2>Executive Summary</h2>
    <div class="summary-box">{{ summary | replace('\n', '<br>') }}</div>

    {% for section in sections %}
    <div class="section">
        <h2>{{ section.heading }}</h2>
        <div>{{ section.content | replace('\n', '<br>') }}</div>
        {% if section.sources %}
        <div class="sources">
            <strong>Sources:</strong>
            <ul>{% for s in section.sources %}<li>{{ s }}</li>{% endfor %}</ul>
        </div>
        {% endif %}
    </div>
    {% endfor %}

    {% if conclusions %}
    <h2>Conclusions</h2>
    <div class="conclusions">{{ conclusions | replace('\n', '<br>') }}</div>
    {% endif %}

    {% if recommendations %}
    <h2>Recommendations</h2>
    <ul class="recommendations">
        {% for rec in recommendations %}<li>{{ rec }}</li>{% endfor %}
    </ul>
    {% endif %}

    <footer>Report generated by the Autonomous Research Agent</footer>
</body>
</html>
